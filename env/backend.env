# Backend env for local harness runs. Every value here is a local/test value.
# Never point this file at Railway: bin/backend.sh refuses non-local URLs.
# DATABASE_URL / REDIS_URL / PORT are filled in by bin/backend.sh per instance.

NODE_ENV=production
LOG_LEVEL=debug

# Reached via preload/egress.cjs -> fakes server. The values only need to be
# non-empty for the eBay OAuth client and the AWS SDK to construct.
EBAY_CLIENT_ID=harness-ebay-client
EBAY_CLIENT_SECRET=harness-ebay-secret
EBAY_CLIENT_DEV_ID=harness-ebay-client
EBAY_CLIENT_DEV_SECRET=harness-ebay-secret
EBAY_DEV_ID=harness-dev
EBAY_VERIFICATION_TOKEN=harness-verification-token-0123456789abcdef0123456789
EBAY_NOTIFICATION_ENDPOINT=http://localhost:3000/api/ebay-notifications
EBAY_NOTIFICATIONS=false

AWS_ACCESS_KEY_ID=AKIAHARNESSFAKE00000
AWS_SECRET_ACCESS_KEY=harness-fake-secret
AWS_SES_FROM_EMAIL=alerts@harness.test
AWS_ENDPOINT_URL_SES=http://127.0.0.1:4010

JWT_SECRET=harness-jwt-secret
SESSION_SECRET=harness-session-secret
FRONTEND_URL=http://localhost:3001
API_URL=http://localhost:3000

HARNESS_FAKES_URL=http://127.0.0.1:4010
HARNESS_EGRESS=block

# Prisma CLI telemetry (otherwise blocked by the egress guard every run)
CHECKPOINT_DISABLE=1
