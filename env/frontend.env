# Frontend (next-esentry) env for local harness runs. Local/test values only.
# DATABASE_URL and BACKEND_API_URL are filled in by bin/frontend.sh.

BETTER_AUTH_SECRET=harness-better-auth-secret-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3001
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3001
NEXT_TELEMETRY_DISABLED=1

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAHARNESSFAKE00000
AWS_SECRET_ACCESS_KEY=harness-fake-secret
AWS_SES_FROM_EMAIL=noreply@harness.test
AWS_ENDPOINT_URL_SES=http://127.0.0.1:4010

# Social providers are unreachable in the harness (egress blocked); email +
# password sign-up with the fake SES inbox is the supported login path.
AUTH_GITHUB_ID=harness
AUTH_GITHUB_SECRET=harness
AUTH_GOOGLE_ID=harness
AUTH_GOOGLE_SECRET=harness
FACEBOOK_CLIENT_ID=harness
FACEBOOK_CLIENT_SECRET=harness

HARNESS_FAKES_URL=http://127.0.0.1:4010
HARNESS_EGRESS=block

# Prisma CLI telemetry (otherwise blocked by the egress guard every run)
CHECKPOINT_DISABLE=1
